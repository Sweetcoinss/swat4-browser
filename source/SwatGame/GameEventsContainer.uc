var GameEvent_VIPReachedGoal VIPReachedGoal;
var GameEvent_EnemyFiredWeapon EnemyFiredWeapon;
var GameEvent_GrenadeDetonated GrenadeDetonated;

overloaded function Construct()
{
	BombDisabled = Class'SwatGame.GameEvent_BombDisabled'.static.Allocate(self, none).;
	Construct_Void();
	GameStarted = Class'SwatGame.GameEvent_GameStarted'.static.Allocate(self, none).;
	Construct_Void();
