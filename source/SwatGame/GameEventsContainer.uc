	Construct_Void();
	MissionCompleted = Class'SwatGame.GameEvent_MissionCompleted'.static.Allocate(self, none).;
	Construct_Void();
	MissionEnded = Class'SwatGame.GameEvent_MissionEnded'.static.Allocate(self, none).;
	Construct_Void();
	MissionFailed = Class'SwatGame.GameEvent_MissionFailed'.static.Allocate(self, none).;
	Construct_Void();
	PawnArrested = Class'SwatGame.GameEvent_PawnArrested'.static.Allocate(self, none).;
	Construct_Void();
	PawnDamaged = Class'SwatGame.GameEvent_PawnDamaged'.static.Allocate(self, none).;
	Construct_Void();
	PawnDestroyed = Class'SwatGame.GameEvent_PawnDestroyed'.static.Allocate(self, none).;
	Construct_Void();
	PawnDied = Class'SwatGame.GameEvent_PawnDied'.static.Allocate(self, none).;
	Construct_Void();
	ReportableReportedToTOC = Class'SwatGame.GameEvent_ReportableReportedToTOC'.static.Allocate(self, none).;
	Construct_Void();
	PawnIncapacitated = Class'SwatGame.GameEvent_PawnIncapacitated'.static.Allocate(self, none).;
	Construct_Void();
	PawnUnarrestBegan = Class'SwatGame.GameEvent_PawnUnarrestBegan'.static.Allocate(self, none).;
	Construct_Void();
	PawnUnarrested = Class'SwatGame.GameEvent_PawnUnarrested'.static.Allocate(self, none).;
	Construct_Void();
	PlayerDied = Class'SwatGame.GameEvent_PlayerDied'.static.Allocate(self, none).;
	Construct_Void();
	Special = Class'SwatGame.GameEvent_Special'.static.Allocate(self, none).;
	Construct_Void();
	VIPReachedGoal = Class'SwatGame.GameEvent_VIPReachedGoal'.static.Allocate(self, none).;
	Construct_Void();
	EnemyFiredWeapon = Class'SwatGame.GameEvent_EnemyFiredWeapon'.static.Allocate(self, none).;
	Construct_Void();
	GrenadeDetonated = Class'SwatGame.GameEvent_GrenadeDetonated'.static.Allocate(self, none).;
	Construct_Void();
	return;
}
