class DynamicFlashlightLight extends DynamicLight
	config
	hidecategories(Karma,Karma,Force,Collision,Object,Sound);

defaultproperties
{
	LightEffect=2
	LightBrightness=180.0000000
	LightRadius=45.0000000
	LightCone=25
	bOnlyAffectCurrentZone=false
	bHidden=false
	bNoDelete=false
	bStasis=false
	bBlockZeroExtentTraces=false
	bBlockNonZeroExtentTraces=false
	bWeaponTestsPassThrough=true
	bDirectional=true
}