[SP-Casino]
PrimarySpawnPoint=Puerta trasera
CampaignObjectiveEnemySpawn=("Louie Baccus","Simon Grover","Allen Kruse")
CampaignObjectiveHostageSpawn=("Jeremy Walsh")
MissionDescription=("Orden judicial de alto riesgo","1092 Westfield Road","24 de Febrero - 17:32")
BriefingText=("Éste es un poco difícil. Antivicio ha estado vigilando Expendedoras y tragaperras Northside durante las últimas tres o cuatro semanas. Se estaba investigando un caso sobre supuestas operaciones de apuestas en el sótano del establecimiento. El detective encubierto Jeremy Walsh había estado trabajando codo a codo con los sospechosos, y hoy recibió una invitación para entrar al área de apuestas.  ","|Todo iba bien hasta que se perdió de vista a Walsh. El micrófono de Walsh nos permitió saber que todavía estaba hablando con los sospechosos, que no mostraban indicios de sospechar de él. Unos pocos minutos más tarde se escuchó una repentina interferencia y el micrófono de Walsh dejó de emitir. Si todo salía como estaba planeado, Walsh ya debería haber regresado, ya que debía entrar, hacer una apuesta y volver a salir.  No tenemos forma de conocer el estado real de Walsh, por lo que asumimos que está en peligro y ha llegado la hora de ir a por él. ","|Sabemos que hay al menos tres individuos. El primero, Louie Baccus, es el propietario de la tienda. Los otros dos son Allen Kruse y Simon Gowan.  Kruse y Gowan parecen ser los cabecillas de la operación de apuestas, mientras que Baccus los cubre y les proporciona un lugar. Antivicio cree que hay más sospechosos dentro, que actúan como apostantes y corredores. Se desconoce la cifra exacta, pero podrían ser hasta 10 sospechosos en total. Ésa es la razón por la que se envió a Walsh, para determinar el número exacto de involucrados.  ","|Kruse y Gowan tienen un amplio historial delictivo, que va desde pequeños hurtos a robo a mano armada.  Consideradlos a ambos como armados y peligrosos.  Baccus es un desconocido, pero teniendo en cuenta el historial de sus compatriotas, debemos creer que también está armado. En su última conversación grabada, Walsh habló sorprendido del 'tamaño del tinglado'.  Parecía que estaba impresionado, algo que no puede ser bueno para nosotros.  ","|Tenemos un plano de la tienda, pero no tenemos nada del sótano. Sabemos que se accede a través del almacén, pero no sabemos nada del lugar de apuestas. Mantened los ojos abiertos; podría haber muchas sorpresas. Ha llegado el momento de sacar a Walsh de allí y poner bajo custodia a los sospechosos. Escoged vuestro equipo con cuidado y partid. ")
LocationInfoText=("Expendedoras y tragaperras Northside, 1092 Westfield Road","|Sierra One cubre el Lado 3, Nivel 1; comunica que hay una gran habitación tipo almacén.")
HostageName=("Jeremy Walsh","Louie Baccus")
HostageVitals=("Sexo: Hombre|Origen: Caucásico|Pelo: Marrón|Ojos: Marrones|Altura: 1,85|Peso: 72|Fecha de nacimiento: 01/04/1975|Edad: 33","Sexo: Hombre|Origen: Caucásico|Pelo: Negro|Ojos: Azules|Altura: 1,55|Peso: 86|Fecha de nacimiento: 04/19/1966|Edad: 42")
HostageDescription=("El detective Walsh ha estado trabajando encubierto en la mafia durante algún tiempo y es una fuente de información fiable sobre las operaciones de ésta.","Propietario de Expendedoras Northside. Baccus no ha sido arrestado nunca, pero es sospechoso de estar relacionado con el crimen organizado.")
SuspectName=("Allen Kruse","Simon Gowan")
SuspectVitals=("Sexo: Hombre|Origen: Caucásico|Pelo: Marrón|Ojos: Azules|Altura: 1´55|Peso: 86|Fecha de nacimiento: 01/02/1964|Edad: 44","Sexo: Hombre|Origen: Caucásico|Pelo: Marrón claro|Ojos: Azules|Altura: 1´89|Peso: 95|Fecha de nacimiento: 07/29/1979|Edad: 29")
SuspectDescription=("Aparece casi todos los días por Expendedoras Northside. Ha sido condenado por posesión ilegal de armas y asalto simple. Arrestado por extorsión, pero no condenado.  ","Cliente habitual de Expendedoras Northside. Ha sido condenado por asalto a mano armada y robo.")
EntryOptionTitle=("Lado 3, Nivel 1.")
EntryDescription=("Puerta trasera al establecimiento.")
TimeLinePlot=(0,42,71,88,98,100)
TimeLineTime=("14:03","15:30","16:30","17:05","17:28","17:32")
TimeLineShortDescription=("Walsh se registra","Se pierde la señal del micrófono de Walsh","Teniente de Walsh informado","Órdenes expedidas","Llega SWAT","Comienza la entrada táctica")
TimeLineLongDescription=(" - El detective Walsh se registra con su manipulador y le notifica que entrará en la tienda a las 12:45."," - El micrófono de Walsh se queda estático sin ninguna indicación de cuál es la avería."," - Se pone al tanto de la situación y de la llamada perdida al teniente Collins. Todos los agentes involucrados creen que Walsh ya forma parte de ellos. El fiscal ha sido notificado."," - Órdenes de arresto expedidas.  SWAT enviados a escena."," - Vigilancia desde zonas elevadas y perímetro de contención establecido."," - Se ha decidido utilizar la estrategia. Equipo de asalto preparado.")
LoadingText=1092 Westfield Road, Expendedoras y tragaperras Northside

[SP-ABomb]
PrimarySpawnPoint=Entrada delantera
SecondarySpawnPoint=Entrada de servicio
MissionDescription=("Despliegue rápido","127 Avenida Adelaide","12 de diciembre - 23:42")
BriefingText=("Se nos solicita que realicemos un despliegue rápido en un tiroteo en el club nocturno A Bomb. Hay al menos cuatro personas disparándose, probablemente más. No parecen estar atacando a civiles activamente, o intentando tomar rehenes, a pesar de que se nos ha informado de varios heridos por el fuego cruzado. Los informes de los testigos son confusos y en algunos casos  contradictorios.","|Tenemos a tiradores caucásicos e hispanos, disparándose en dos bandos divididos por su raza. Todos parecen ser hombres adultos y jóvenes.","|Tenemos dos entradas posibles: la puerta principal, pasando la taquilla, y una zona de carga en el callejón trasero. Tenemos un pobre boceto del plano gracias a un barman de la casa; echad una ojeada, pero no os fiéis demasiado.","|La mayoría de los clientes han logrado escapar, aunque todavía hay civiles atrapados allí. Según los testigos, algunos de ellos están heridos. El perímetro todavía informa de disparos esporádicos y los equipos médicos no entrarán hasta que hayamos despejado el edificio. Tenéis que entrar y poner orden. Encontrad y arrestad a los pistoleros. Además, deberéis localizar y asegurar la evacuación del resto de los civiles, especialmente los heridos. Revisad la información, escoged la entrada, y equipaos juntos. Ha llegado la hora de trabajar.")
LocationInfoText=("127 Avenida Adelaide","Hay un escenario principal y otro secundario en el primer piso y ambos tienen una zona de bar adosada. Hay un segundo piso con la oficina del encargado y un salón adicional. El mapa está lo mejor esbozado posible y es la única información sobre el plano disponible.  ")
HostageName=("Desconocido")
HostageVitals=("Información no disponible")
HostageDescription=("")
SuspectName=("Latinos desconocidos","Caucásicos desconocidos")
SuspectVitals=("Órganos vitales desconocidos","Órganos vitales desconocidos")
SuspectDescription=("Miembros de una banda. Descendencia latina","Miembros de una banda. Descendencia caucásica")
EntryOptionTitle=("Lado 2, Nivel 1", "Lado 1, Nivel 1")
EntryDescription=("Entrada de servicio, a un lado del callejón","Entrada central")
TimeLinePlot=(0,20,100)
TimeLineTime=("23:27","23:30","23:42")
TimeLineShortDescription=("Disparos; llamadas al 911","Perímetro establecido","Llegan los SWAT")
TimeLineLongDescription=(" - Las primeras llamadas al 911 registradas informan sobre tiroteos en el club. SWAT notificado"," - Las unidades patrulla llegan a la escena y comienzan a establecer el perímetro y a suministrar primeros auxilios a las víctimas iniciales. Radios de patrullas por ambulancias."," - SWAT entra en escena. Debido al fuego constante, SWAT decide inmediatamente emplear la estrategia para neutralizar la situación.")
LoadingText=127 Avenida Adelaide, Club nocturno A Bomb

