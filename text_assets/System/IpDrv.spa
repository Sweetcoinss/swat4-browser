[UpdateServerCommandlet]
HelpCmd=updateserver
HelpOneLiner=Reparar peticiones de actualizaciones automáticas de motor Unreal.
HelpUsage=updateserver [-option...] [parm=value]
HelpParm[0]=ConfigFile
HelpDesc[0]=Archivo de configuración a utilizar. Predeterminado: UpdateServer.ini

[MasterServerCommandlet]
HelpCmd=masterserver
HelpOneLiner=Mantener lista maestra de servidores.
HelpUsage=masterserver [-option...] [parm=value]
HelpParm[0]=ConfigFile
HelpDesc[0]=Archivo de configuración a utilizar. Predeterminado: MasterServer.ini

[CompressCommandlet]
HelpCmd=comprimir
HelpOneLiner=Comprimir un paquete Unreal para descargar automáticamente. Se creará un archivo con extensión .uz.
HelpUsage=Comprimir File1 [File2 [File3 ...]]
HelpParm[0]=Archivos
HelpDesc[0]=El comodín o nombres de archivo a descomprimir.

[DecompressCommandlet]
HelpCmd=descomprimir
HelpOneLiner=Descomprimir un archivo con compresión ucc.
HelpUsage=decompress CompressedFile
HelpParm[0]=CompressedFile
HelpDesc[0]=El archivo .uz a descomprimir.

