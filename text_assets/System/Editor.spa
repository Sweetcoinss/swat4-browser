[ExecMacroCommandlet]
HelpCmd=ejecutarmacro
HelpOneLiner=Ejecuta un archivo de secuencias de comandos editor de macros.
HelpUsage=execmacro scriptfile
HelpParm[0]=El nombre de archivo de la secuencia de comandos a ejecutar. Ten en cuenta que DEBE ser un archivo de secuencias de comandos específico de no nivel, como crear nuevas fuentes.


[SetInstancePropertyCommandlet]
HelpCmd=setinstanceproperty
HelpOneLiner=Establece una propiedad en un objeto presente en uno o más mapas.
HelpUsage=setinstanceproperty -nobind -ObjectClass -InstanceOuterAncestor -PropertyName -"PropertyValueAsText" Map_A Map_B ... Map_Last
HelpParm[0]=

[CompressNormalMapsCommandlet]
HelpCmd=comprimirmapasnormales
HelpOneLiner=Comprimir mapas normales en paquetes con un formato específico
HelpUsage=compressnormalmapps informat=INFMT outformat=OUTFMT packages=WILDCARD <verbose=[true|false]>
HelpParm[0]=INFMT
HelpDesc[0]=El formato original de mapas normales que debe ser comprimido; debe ser uno de [[any|rgba8|cxv8u8|dxt5n]
HelpParm[0]=OUTFMT
HelpDesc[0]=El formato en el que comprimir los mapas normales; debe ser uno de [cxv8u8|dxt5n]
HelpParm[0]=COMODÍN
HelpDesc[0]=Un comodín que coincide con los nombres de uno o más paquetes de texturas (por ejemplo, "Arma*Tex.*")

[RebuildMoppsCommandlet]
HelpCmd=reconstruirmopps
HelpOneLiner=Reconstruir el Havok MOPP para uno o más mapas
HelpUsage=rebuildmopp Map_A Map_B ... Map_Last
HelpParm[0]=El nombre del mapa para el que debe ser reconstruido el MOPP

[MasterCommandlet]
HelpCmd=maestro
HelpOneLiner=Construir archivos de instalador maestro
HelpUsage=master [-option...] [parm=value]...
HelpParm[0]=MasterPath
HelpDesc[0]=Directorio raíz del que copiar archivos fuente
HelpParm[1]=SrcPath
HelpDesc[1]=Directorio raíz donde copiar archivos fuente (lanzamiento)
HelpParm[2]=RefPath
HelpDesc[2]=Ruta para referencia de ruta delta comprimida

[MapConvertCommandlet]
HelpCmd=convertirmapa
HelpOneLiner=Convierte mapas de formato antiguo a nuevo (no hay transformaciones de pincel)
HelpUsage=mapconvert SrcFilename DstFilename
HelpParm[0]=SrcFilename
HelpDesc[0]=El nombre de archivo de mapa del que leer
HelpParm[1]=DstFilename
HelpDesc[1]=El nombre de archivo de mapa al que escribir

[ConformCommandlet]
HelpCmd=alinear
HelpOneLiner=Generar archivos binarios conformes
HelpUsage=conform existing_file.ext old_file.ext
HelpParm[0]=existingfile.ext
HelpDesc[0]=Archivo binario existente para cargar, alinear y guardar
HelpParm[1]=oldfile.ext
HelpDesc[1]=Archivo antiguo con el que hacer que el archivo fuente binario sea compatible

[PkgCommandlet]
HelpCmd=pkg
HelpOneLiner=Importa/exporta información de/a paquetes utilizando estructuras de directorio.
HelpUsage=pkg [import/export] [texture/sound] [packagename] [directory]
HelpParm[0]=importar/exportar
HelpDesc[0]=Lo que estás intentando hacer con la información
HelpParm[1]=texture/sound
HelpDesc[1]=El tipo de paquete con el que estás trabajando
HelpParm[2]=packagename
HelpDesc[2]=El paquete del que estás creando/exportando
HelpParm[3]=directory
HelpDesc[3]=El directorio del que leer/al que escribir

[PackageFlagCommandlet]
HelpCmd=indicadordepaquete
HelpOneLiner=Establecer banderas de paquete en archivos de paquete
HelpUsage=packageflag src.ext [dest.ext <+|->flag [<+|->flag] ...]
HelpParm[0]=src.ext
HelpDesc[0]=Archivo de paquete existente para cargar
HelpParm[1]=dest.exe
HelpDesc[1]=Nombre de nuevo archivo de paquete con la nueva configuración de bandera
HelpParm[2]=flag
HelpDesc[2]=+ para establecer una bandera o - para eliminarla, seguido de uno de:
HelpParm[3]=" "
HelpDesc[3]="  AllowDownload"
HelpParm[4]=" "
HelpDesc[4]="  ClientOptional"
HelpParm[5]=" "
HelpDesc[5]="  ServerSideOnly"
HelpParm[6]=" "
HelpDesc[6]="  BrokenLinks"
HelpParm[7]=" "
HelpDesc[7]="  Unsecure"

[MakeCommandlet]
HelpCmd=realizar
HelpOneLiner=Reconstruir paquetes UnrealScript
HelpUsage=make [-option...] [parm=value]...
HelpParm[0]=En silencio
HelpDesc[0]=No hay advertencias; "sí" a todas las preguntas
HelpParm[1]=NoBind
HelpDesc[1]=No fuerces funciones nativas a unirse a DLL
HelpParm[2]=All
HelpDesc[2]=Limpiar reconstrucción (de lo contrario la reconstrucción es incremental)

[DXTConvertCommandlet]
HelpCmd=conversióndxt
HelpOneLiner=Convertir texturas DXT3/5 a DXT1/ RGBA
HelpUsage=dxtconvert srcpath destpath
HelpParm[0]=srcpath
HelpDesc[0]=Ruta que contiene los archivos fuente
HelpParm[1]=destpath
HelpDesc[1]=Ruta para los archivos de destino


[AnalyzeContentCommandlet]
HelpCmd=analizarcontenido
HelpOneLiner=Analiza mapa
HelpUsage=analyzecontent mapname
HelpParm[0]=mapname
HelpDesc[0]=Ruta a un archivo de mapa


[BatchExportCommandlet]
HelpCmd=batchexport
HelpOneLiner=Exportar objetos en cantidades
HelpUsage=batchexport package.ext classname export_ext
HelpParm[0]=package.ext
HelpDesc[0]=Paquete cuyos objetos quieres exportar
HelpParm[1]=classname
HelpDesc[1]=Clase de objeto a exportar
HelpParm[2]=export_ext
HelpDesc[2]=Extensión de archivo a la que exportar
HelpParm[3]=path
HelpDesc[3]=Ruta donde exportar archivos, como c:\mi ruta

[DataRipCommandlet]
HelpCmd=borrardatos
HelpOneLiner=Crea un paquete con información extraída de Texturas, Música y Sonido.
HelpUsage=datarip srcpackage.ext dstpackage.ext
HelpParm[0]=srcpackage.ext
HelpDesc[0]=Paquete fuente
HelpParm[1]=dstpackage.ext
HelpDesc[1]=Paquete de destino
