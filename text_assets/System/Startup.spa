[IDDIALOG_ConfigPageDetail]
IDC_ConfigPageDetail=
IDC_DetailPrompt=El motor Unreal ha seleccionado las siguientes opciones para optimizar el funcionamiento de tu ordenador dependiendo de la velocidad, la memoria y la tarjeta de vídeo.
IDC_DetailNote=Puedes cambiar estas opciones desde la ventana "Preferencias" del juego más tarde.

[IDDIALOG_ConfigPageFirstTime]
IDC_ConfigPageFirstTime=
IDC_Prompt=El motor Unreal se está iniciando por primera vez. Si experimentas problemas, lee las notas de la versión en la sección "Programas / Unreal Tournament" del menú "Inicio" de Windows.

[IDDIALOG_ConfigPageSafeMode]
IDC_ConfigPageSafeMode=
IDC_SafeModePrompt=El motor Unreal no se cerró correctamente la última vez que se ejecutó. Si se cerró por un problema, puedes utilizar las siguientes opciones para recuperar.
IDC_SafeModePrompt2=Opciones del modo seguro del motor Unreal: Si estás experimentando problemas, puedes utilizar las siguientes opciones para recuperar.
IDC_Run=Ejecutar motor Unreal
IDC_SafeMode=Ejecutar motor Unreal en modo seguro para solucionar problemas
IDC_Web=Visita nuestro sitio web para obtener información sobre cómo solucionar problemas

[IDDIALOG_ConfigPageSafeOptions]
IDC_ConfigPageSafeOptions=
IDC_SafeOptions=Opciones de modo seguro para diagnosticar problemas
IDC_NoSound=Deshabilitar todo el sonido
IDC_Res=Ejecutar en resolución estándar 640x480
IDC_ResetConfig=Restablecer todas las opciones de configuración a los valores predeterminados
IDC_NoProcessor=Deshabilitar extensiones de procesador Pentium III/3DNow
IDC_NoJoy=Deshabilitar el soporte del joystick
